{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Bash(uv run pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin main)",
      "Bash(git rebase origin/main)",
      "Bash(git push -u origin HEAD)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(orca skills get:*)",
      "Bash(orca orchestration worker-list:*)",
      "Bash(orca orchestration worker-show:*)",
      "Bash(orca orchestration worker-read:*)",
      "Bash(orca worktree list:*)",
      "Bash(npm --prefix web install:*)",
      "Bash(npm --prefix web run lint:*)",
      "Bash(npm --prefix web run typecheck:*)",
      "Bash(npm --prefix web run test:*)",
      "Bash(npm --prefix web run build:*)",
      "Bash(npm --prefix web run dev:*)",
      "Bash(npm --prefix web run preview:*)",
      "Bash(npm --prefix web ci)",
      "Bash(docker compose up -d --wait)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(uv run martom migrate)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.env.production)",
      "Bash(cat *.env*)",
      "Bash(git diff *.env*)",
      "Bash(git log *.env*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review * --approve*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push origin :*)",
      "Bash(git push *+*)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit * -n *)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(git rebase * --exec*)",
      "Bash(git rebase * -x*)",
      "Bash(git rebase * -i*)",
      "Bash(git rebase -i*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase * --interactive*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git fetch * -u *)",
      "Bash(git pull *--upload-pack*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git show *--ext-diff*)",
      "Bash(git diff *--no-index*)",
      "Bash(git -c *)",
      "Bash(git -C * -c *)"
    ]
  }
}
