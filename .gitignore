# --- Secrets and local config (public repo: never commit these) ---
.env
.env.*
*.env
!.env.example
*.pem
*.key
.claude/settings.local.json
.argent/

# --- Data dumps, exports and customer data ---
/data/
/dumps/
/exports/
*.dump
*dump*.json
*.sql.gz
*.csv
*.jsonl
# Recorded test fixtures and eval sets may be CSV/JSONL (only those types).
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.jsonl
!evals/**/*.jsonl
!tests/fixtures/**/*dump*.json

# --- Review reports and screenshots (local only) ---
.reviews/
/reports/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Node / frontend (M5) ---
node_modules/
.vite/
.wrangler/

# --- Terraform (M6) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- Editors and OS ---
.DS_Store
.idea/
.vscode/
*.swp
