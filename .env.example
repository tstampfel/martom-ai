# martom-ai environment variables.
# Copy to .env for local development: `cp .env.example .env`, then fill in real values.
# Every value below is FAKE. Never commit .env; real secrets live in GitHub Actions
# secrets and AWS Secrets Manager only. The milestone that first reads each variable
# is noted in brackets.

# --- App [M0-4] ---
# local | test | production
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS: only the pages.dev site and localhost. [M0-4]
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://martom-savjetnik.pages.dev

# --- Postgres 16 + pgvector (docker-compose locally, RDS in production) [M0-2] ---
DATABASE_URL=postgresql://martom:martom@localhost:5432/martom
# Server the database tests use; each test creates and drops its own throwaway database
# there. Unset = database tests are skipped. [M0-2]
TEST_DATABASE_URL=postgresql://martom:martom@localhost:5432/postgres
# Host ports docker-compose publishes; change them (and the URLs) if 5432/6379 are taken. [M0-2]
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Redis (docker-compose locally, sidecar container on ECS) [M0-4 health check, M3-5 cache] ---
REDIS_URL=redis://localhost:6379/0

# --- OLX.ba public API (no token needed) [M1-1] ---
OLX_API_BASE_URL=https://api.olx.ba
OLX_SHOP_USERNAME=martom
# Minimum seconds between requests (politeness rule: at most 1 request per 1.3 s).
OLX_MIN_REQUEST_INTERVAL_SECONDS=1.3

# --- Anthropic (Claude) [M2-1] ---
ANTHROPIC_API_KEY=sk-ant-fake-key-for-local-dev
AGENT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# --- Cohere (rerank, maybe embeddings) [M3-3, M3-4] ---
COHERE_API_KEY=fake-cohere-key

# --- LangSmith (tracing and evals) [M2-1] ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_fake_key
LANGSMITH_PROJECT=martom-ai-local

# --- Admin endpoints, e.g. GET /admin/review-issues [M2-3] ---
ADMIN_TOKEN=fake-admin-token-change-me

# --- Orders: WhatsApp click-to-chat number, E.164 format [M5-6] ---
# FAKE number (555-01xx is reserved for fiction). The real one is set only as a GitHub / AWS secret.
ORDER_PHONE=+15555550100

# --- Abuse protection: Cloudflare Turnstile + limits [M5-7] ---
# Cloudflare's documented always-pass test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RATE_LIMIT_PER_MINUTE=20
MAX_TOKENS_PER_CONVERSATION=50000

# --- Customer page: public shop number for the call buttons [M5-2] ---
# Read by web/ at build time (put it in web/.env.local or the Cloudflare Pages settings).
# Public value only; when unset, web/src/config.ts uses Martom's public shop number. Never ORDER_PHONE.
# Fake value below; leave it commented out to use the default.
# VITE_SHOP_PHONE=036 000 000
