# martom-ai environment variables.
# Copy to .env for local development: `cp .env.example .env`, then fill in real values.
# Every value below is FAKE. Never commit .env; real secrets live in GitHub Actions
# secrets and AWS Secrets Manager only. The milestone that first reads each variable
# is noted in brackets.

# --- App [M0-4] ---
# local | test | production
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS: only the pages.dev site and localhost. [M0-4]
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://martom-savjetnik.pages.dev

# --- Postgres 16 + pgvector (docker-compose locally, RDS in production) [M0-2] ---
DATABASE_URL=postgresql://martom:martom@localhost:5432/martom
# Server the database tests use; each test creates and drops its own throwaway database
# there. Unset = this local value; if the server can't be reached, database tests are
# skipped locally and fail in CI. DATABASE_URL also defaults to its value above. [M0-2]
TEST_DATABASE_URL=postgresql://martom:martom@localhost:5432/postgres
# Host ports docker-compose publishes; change them (and the URLs) if 5432/6379 are taken. [M0-2]
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Redis (docker-compose locally, sidecar container on ECS) [M0-4 health check, M3-5 cache] ---
REDIS_URL=redis://localhost:6379/0
# Redis the tests ping (they never write keys). Unset = this local value; if it can't be
# reached, Redis tests are skipped locally and fail in CI. [M0-4]
TEST_REDIS_URL=redis://localhost:6379/0
# Search cache (src/martom/search/cache.py). false = every search pays for its Haiku parse,
# embedding and rerank. Results also expire when the catalogue changes (sync, extract,
# embed). TTLs in seconds: whole results 1 h, parsed filters and query vectors 24 h. [M3-5]
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=3600
QUERY_CACHE_TTL_SECONDS=86400

# --- OLX.ba public API (no token needed) [M1-1; read from Settings by `martom sync` since M1-4] ---
OLX_API_BASE_URL=https://api.olx.ba
OLX_SHOP_USERNAME=martom
# Seconds between OLX request starts: 2.0 by default, values below 1.3 are rejected. Each 429
# raises it by 50% for the rest of the run, up to 6 s (politeness rule). [M1-4]
OLX_REQUEST_INTERVAL=2.0
# Rolling refresh of the nightly sync [M1-4d, #135]: at most this many OLX requests of every
# kind a night (OLX allows 1,000 per fixed hourly window; only the rolling slice gives way),
# and every active listing re-fetched within this many nights. `martom sync --full` ignores both.
OLX_NIGHTLY_REQUEST_BUDGET=950
OLX_ROLLING_REFRESH_DAYS=7

# --- Anthropic (Claude) [M2-1] ---
ANTHROPIC_API_KEY=sk-ant-fake-key-for-local-dev
# The advisor's answers and tool calls [M4-3]; extraction, query parsing, guardrail and
# grading [M2-1, M3-4, M4-3].
AGENT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5
# Listings `martom extract` sends to Claude at the same time (1-16). [M2-1]
EXTRACTION_CONCURRENCY=4

# --- Embeddings for hybrid search [M3-3] ---
# cohere (chosen in M3-3) | local | fake. cohere needs COHERE_API_KEY; local runs an open
# model on this machine (`uv sync --group local-embeddings`); fake gives meaningless vectors,
# only for trying the commands without a key.
EMBEDDING_PROVIDER=cohere
# Unset = the provider's default (cohere: embed-multilingual-v3.0, local:
# intfloat/multilingual-e5-large). Changing it makes `martom embed` re-embed every row.
EMBEDDING_MODEL=embed-multilingual-v3.0

# --- Cohere (embeddings, rerank) [M3-3, M3-4] ---
COHERE_API_KEY=fake-cohere-key
# Rerank model for search; reorders the hybrid top 30. Without COHERE_API_KEY results stay
# in hybrid (RRF) order. [M3-4]
RERANK_MODEL=rerank-v5.0-fast

# --- LangSmith (tracing and evals) [M2-1] ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_fake_key
LANGSMITH_PROJECT=martom-ai-local

# --- Admin endpoints, e.g. GET /admin/review-issues [M2-3] ---
# Sent as `Authorization: Bearer <token>`; at least 32 characters (a shorter value stops the
# API at startup; other commands ignore it). Empty/unset: in APP_ENV=production the API won't
# start; in local/test the endpoints are off (404) with one warning.
# generate: openssl rand -hex 32
ADMIN_TOKEN=

# --- Orders: WhatsApp click-to-chat number, E.164 format [M5-6] ---
# FAKE number (555-01xx is reserved for fiction). The real one is set only as a GitHub / AWS secret.
ORDER_PHONE=+15555550100

# --- Abuse protection: Cloudflare Turnstile + limits [M5-7] ---
# Cloudflare's documented always-pass test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RATE_LIMIT_PER_MINUTE=20
MAX_TOKENS_PER_CONVERSATION=50000

# --- Customer page: public shop number for the call buttons [M5-2] ---
# Read by web/ at build time (put it in web/.env.local or the Cloudflare Pages settings).
# Public value only; when unset, web/src/config.ts uses Martom's public shop number. Never ORDER_PHONE.
# Fake value below; leave it commented out to use the default.
# VITE_SHOP_PHONE=036 000 000
